{
  fields: [
    {
      name: "total_project_cost",
      type: "currency",
      label: "Total Project Cost",
      required: true,
      min: 1,
      max: 10000, // Category 2 limit
      currency: "AUD",
      autoCalculate: true,
      formula: "SUM(itemized_costs.*.total)",
      validation: {
        rule: "value <= 10000",
        message: "ClubsNSW Category 2 grants are for projects up to $10,000. For larger projects, consider other grant programs.",
        level: "error"
      }
    },
    {
      name: "itemized_costs",
      type: "repeatable_table",
      label: "Itemized Costs",
      required: true,
      min: 1,
      helpText: "List each item or service you need to purchase",
      columns: [
        {
          name: "item",
          label: "Item/Service",
          type: "text",
          required: true,
          maxLength: 150,
          width: "45%"
        },
        {
          name: "quantity",
          label: "Qty",
          type: "number",
          required: true,
          min: 1,
          width: "10%"
        },
        {
          name: "unit_price",
          label: "Unit Price",
          type: "currency",
          required: true,
          min: 0.01,
          width: "20%"
        },
        {
          name: "total",
          label: "Total",
          type: "currency",
          calculated: true,
          formula: "quantity * unit_price",
          width: "25%",
          readonly: true
        }
      ]
    },
    {
      name: "grant_amount_requested",
      type: "currency",
      label: "Grant Amount Requested from ClubsNSW",
      required: true,
      min: 1,
      max: "total_project_cost",
      currency: "AUD",
      validation: "Cannot exceed total project cost",
      helpText: "Amount you're requesting from this grant program"
    },
    {
      name: "club_contribution_amount",
      type: "currency",
      label: "Your Club's Contribution (optional but recommended)",
      required: false,
      min: 0,
      currency: "AUD",
      helpText: "Financial contribution from your club strengthens your application"
    },
    {
      name: "other_funding_amount",
      type: "currency",
      label: "Other Funding Sources (optional)",
      required: false,
      min: 0,
      currency: "AUD",
      helpText: "Any other grants or funding you've secured or applied for"
    },
    {
      name: "other_funding_description",
      type: "text",
      label: "Describe Other Funding",
      required: false,
      condition: "other_funding_amount > 0",
      maxLength: 200,
      placeholder: "e.g., Local council grant - $2,000 confirmed"
    },
    {
      name: "budget_summary_display",
      type: "calculated_display",
      label: "Budget Summary",
      readonly: true,
      components: [
        { label: "Total Project Cost", value: "total_project_cost", format: "currency" },
        { label: "Grant Requested", value: "grant_amount_requested", format: "currency" },
        { label: "Your Contribution", value: "club_contribution_amount", format: "currency" },
        { label: "Other Funding", value: "other_funding_amount", format: "currency" },
        { label: "Total Funding", value: "grant_amount_requested + club_contribution_amount + other_funding_amount", format: "currency" }
      ],
      alert: {
        condition: "total_funding < total_project_cost",
        message: "Your total funding doesn't cover the full project cost. Consider increasing contributions or reducing project scope.",
        level: "warning"
      }
    }
  ]
}
