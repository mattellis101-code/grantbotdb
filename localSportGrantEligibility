  ],
  
  // Result calculation
  calculateResult: function(answers) {
    let totalPoints = 0;
    let maxPoints = 5;
    let passed = true;
    let warnings = [];
    let stopMessages = [];
    
    answers.forEach(answer => {
      const question = this.questions.find(q => q.id === answer.questionId);
      const scoring = typeof question.scoring === 'function' 
        ? question.scoring(answer.value)
        : question.scoring[answer.value];
      
      totalPoints += scoring.points;
      
      if (!scoring.pass) {
        passed = false;
        if (scoring.stopHere && question.failureMessage) {
          stopMessages.push(question.failureMessage[answer.value]);
        }
      }
      
      if (scoring.showWarning && question.warningMessage) {
        warnings.push({
          question: question.question,
          message: question.warningMessage[answer.value] || scoring.message
        });
      }
    });
    
    const score = (totalPoints / maxPoints) * 100;
    
    return {
      passed: passed && stopMessages.length === 0,
      score: Math.round(score),
      stopMessages: stopMessages,
      warnings: warnings,
      recommendation: this.getRecommendation(score, passed, stopMessages)
    };
  },
  
  getRecommendation: function(score, passed, stopMessages) {
    if (stopMessages.length > 0) {
      return {
        status: "not_eligible",
        title: "Not Eligible",
        message: "Based on your answers, your club is not currently eligible for this grant.",
        icon: "❌",
        color: "red",
        actions: [
          {
            label: "View Requirements",
            action: "show_requirements"
          },
          {
            label: "Try ClubsNSW Grant",
            action: "switch_to_clubsnsw"
          }
        ]
      };
    }
    
    if (score >= 80) {
      return {
        status: "highly_eligible",
        title: "Great News! You're Highly Eligible",
        message: "Your club appears to meet all the key criteria. You're ready to start your application.",
        icon: "✅",
        color: "green",
        nextStep: "Start Application",
        estimatedTime: "2-3 hours to complete"
      };
    } else if (score >= 60) {
      return {
        status: "eligible_with_preparation",
        title: "Eligible - Some Preparation Needed",
        message: "You're eligible, but should address some areas to strengthen your application.",
        icon: "⚠️",
        color: "orange",
        nextStep: "Review Warnings Below",
        actionRequired: true
      };
    } else {
      return {
        status: "marginal",
        title: "Marginal Eligibility",
        message: "You may be eligible, but significant preparation is needed for a competitive application.",
        icon: "⚠️",
        color: "orange",
        nextStep: "Review All Warnings",
        actionRequired: true
      };
    }
  }
};
