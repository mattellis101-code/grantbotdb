        programs: { points: 0.5, pass: true, showWarning: true },
        other: { points: 0, pass: true, showWarning: true }
      },
      warningMessage: {
        facilities_repair: "Routine maintenance is generally not funded. Your project must involve significant improvement or upgrade work.",
        programs: "Program funding is available but is competitive. Ensure your program demonstrates clear community benefit.",
