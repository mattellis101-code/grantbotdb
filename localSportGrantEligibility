      options: [
        { value: "equipment", label: "Sports equipment purchase" },
        { value: "facilities_new", label: "New facility construction" },
        { value: "facilities_upgrade", label: "Facility upgrade or improvement" },
        { value: "facilities_repair", label: "Facility repairs or maintenance" },
        { value: "programs", label: "Program development or delivery" },
        { value: "other", label: "Other" }
      ],
      scoring: {
        equipment: { points: 1, pass: true },
        facilities_new: { points: 1, pass: true },
        facilities_upgrade: { points: 1, pass: true },
