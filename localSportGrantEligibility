      }
    },
    
    {
      id: "q4",
      question: "What is your estimated total project cost?",
      type: "currency",
      required: true,
      min: 0,
      placeholder: "Enter amount",
      helpText: "Include all costs: materials, labor, equipment, etc.",
      scoring: function(value) {
        if (value < 2000) {
          return { 
            points: 0.3, 
            pass: true, 
            showWarning: true,
            message: "Very small projects may be better suited to ClubsNSW or local council grants."
          };
        } else if (value >= 2000 && value <= 100000) {
          return { 
            points: 1, 
